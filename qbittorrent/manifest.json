{
  "manifestVersion": 1,
  "meta": {
    "name": "qBittorrent",
    "version": "0.0.4",
    "logoPath": "logo.png",
    "shortDescription": "Torrent client with web UI",
    "longDescription": "qBittorrent-nox headless client. Pairs with the Radarr/Sonarr pups as their download client, with finished downloads bridged into the Jellyfin library by the host sync timer. Web UI on port 8080.",
    "upstreamVersions": {
      "qBittorrent": "5.x"
    }
  },
  "config": {
    "sections": null
  },
  "container": {
    "build": {
      "nixFile": "pup.nix",
      "nixFileSha256": "0bf917800102c80462f4a036d1112a4e710709b432d086ffee1a4798894c34d3"
    },
    "services": [
      {
        "name": "qbittorrent",
        "command": {
          "exec": "/bin/run.sh",
          "cwd": "",
          "env": null
        }
      }
    ],
    "exposes": [
      {
        "name": "web",
        "type": "http",
        "port": 8080,
        "interfaces": null,
        "listenOnHost": true,
        "webUI": true
      }
    ],
    "requiresInternet": true
  },
  "interfaces": null,
  "dependencies": null,
  "metrics": null
}