{
  "manifestVersion": 1,
  "meta": {
    "name": "qBittorrent",
    "version": "0.0.2",
    "logoPath": "logo.png",
    "shortDescription": "Torrent client with web UI",
    "longDescription": "qBittorrent-nox headless client. Pairs with the Radarr/Sonarr pups as their download client, with finished downloads bridged into the Jellyfin library by the host sync timer. Web UI on port 8080.",
    "upstreamVersions": {
      "qBittorrent": "5.x"
    }
  },
  "config": {
    "sections": null
  },
  "container": {
    "build": {
      "nixFile": "pup.nix",
      "nixFileSha256": "d7ba2a0a14d5ed14204cca7a7a24ed289ea5ba89cd45cecb93e6795eb647cebd"
    },
    "services": [
      {
        "name": "qbittorrent",
        "command": {
          "exec": "/bin/run.sh",
          "cwd": "",
          "env": null
        }
      }
    ],
    "exposes": [
      {
        "name": "web",
        "type": "http",
        "port": 8080,
        "interfaces": null,
        "listenOnHost": true,
        "webUI": true
      }
    ],
    "requiresInternet": true
  },
  "interfaces": null,
  "dependencies": null,
  "metrics": null
}